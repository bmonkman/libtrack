# Local development. Copy to .env. Do not `vercel env pull` over this file: Vercel's values
# point at the production database.
DATABASE_URL=postgres://postgres:pg@localhost:54329/libtrack
CRON_SECRET=local-cron-secret
ALLOWED_ORIGIN=http://localhost:5173
NODE_ENV=development
# WEBAUTHN_RP_ID defaults to localhost
# Photo matching (optional locally): a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
